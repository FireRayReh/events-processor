{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.internal/audit/audit-export-request.v1.schema.json",
  "title": "Create export (POST /api/audit/exports)",
  "description": "Returns 202 with an AuditExportJob. Snapshot bounds: filter.to and ingested_at <= requestedAt.",
  "type": "object",
  "required": ["filter", "format"],
  "additionalProperties": false,
  "properties": {
    "filter":  { "$ref": "audit-filter.v1.schema.json" },
    "format":  { "enum": ["csv", "ndjson"], "description": "csv is capped at 1,048,575 data rows (Excel limit); use ndjson above that or with changes." },
    "columns": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "enum": ["eventId", "occurredAt", "ingestedAt", "service", "action", "outcome", "actorType", "actorId", "actorDisplayName", "entityType", "entityId", "summary", "reason", "correlationId", "sourceIp"] },
      "default": ["occurredAt", "service", "action", "outcome", "actorId", "entityType", "entityId", "summary"]
    },
    "includeChanges": { "type": "boolean", "default": false, "description": "Joins audit_event_detail per chunk; ~3x slower." },
    "maxRows":        { "type": "integer", "minimum": 1, "maximum": 1000000, "default": 1000000 },
    "timeZone":       { "type": "string", "default": "UTC", "description": "IANA zone used to render timestamps in the file; stored values stay UTC." }
  }
}
